# Normaliza finales de línea en el repositorio (LF), convierte al hacer checkout.
* text=auto

# Fuente y configuración
*.kt      text eol=lf
*.kts     text eol=lf
*.java    text eol=lf
*.xml     text eol=lf
*.toml    text eol=lf
*.pro     text eol=lf
*.properties text eol=lf
*.md      text eol=lf
*.sh      text eol=lf
gradlew   text eol=lf

# Scripts de Windows
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binarios
*.jar     binary
*.png     binary
*.webp    binary
*.jpg     binary
*.ttf     binary
*.otf     binary
*.ico     binary
